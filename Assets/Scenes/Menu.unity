  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u2022 \u0E25\u0E32\u0E01\u0E19\u0E34\u0E49\u0E27\u0E0B\u0E49\u0E32\u0E22-\u0E02\u0E27\u0E32\u0E40\u0E1E\u0E37\u0E48\u0E2D\u0E40\u0E25\u0E47\u0E07
    \u0E1B\u0E25\u0E48\u0E2D\u0E22\u0E19\u0E34\u0E49\u0E27\u0E40\u0E1E\u0E37\u0E48\u0E2D\u0E17\u0E34\u0E49\u0E07\u0E1B\u0E25\u0E32\n\u2022
    \u0E1B\u0E25\u0E32 layer \u0E40\u0E14\u0E35\u0E22\u0E27\u0E01\u0E31\u0E19\u0E0A\u0E19\u0E01\u0E31\u0E19
    = \u0E23\u0E27\u0E21\u0E40\u0E1B\u0E47\u0E19 layer \u0E16\u0E31\u0E14\u0E44\u0E1B\n\u2022
    \u0E1B\u0E25\u0E32 layer 7 \u0E2A\u0E2D\u0E07\u0E15\u0E31\u0E27\u0E23\u0E27\u0E21\u0E01\u0E31\u0E19
    = Top Merge \u0E04\u0E30\u0E41\u0E19\u0E19 x2\n\u2022 \u0E1B\u0E25\u0E32\u0E04\u0E49\u0E32\u0E07\u0E40\u0E2B\u0E19\u0E37\u0E2D\u0E40\u0E2A\u0E49\u0E19\u0E41\u0E14\u0E07\u0E19\u0E32\u0E19
    2 \u0E27\u0E34\u0E19\u0E32\u0E17\u0E35 = \u0E08\u0E1A\u0E40\u0E01\u0E21\n\u2022
    \u0E08\u0E31\u0E14 Deck 7 \u0E0A\u0E48\u0E2D\u0E07 (layer 1\u20137) \u0E1B\u0E25\u0E32\u0E41\u0E15\u0E48\u0E25\u0E30\u0E15\u0E31\u0E27\u0E21\u0E35\u0E04\u0E27\u0E32\u0E21\u0E2A\u0E32\u0E21\u0E32\u0E23\u0E16\u0E15\u0E48\u0E32\u0E07\u0E01\u0E31\u0E19"
